   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "from evidently import Report\n",
    "from evidently.presets import DataDriftPreset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "4afc5099-a975-4632-8daf-864d230a5909",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Reference data: (350, 8)\n",
      "Current data: (150, 8)\n"
     ]
    }
   ],
   "source": [
    "df = pd.read_excel(\"data/House_Price_Prediction_Dataset.xlsx\")\n",
    "\n",
    "reference_data = df.sample(frac=0.7, random_state=42)\n",
    "current_data = df.drop(reference_data.index)\n",
    "\n",
    "print(\"Reference data:\", reference_data.shape)\n",
    "print(\"Current data:\", current_data.shape)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "c5c7c786-8144-4ea1-b2f3-0097507c66ef",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Drift report generated successfully!\n"
     ]
    }
   ],
   "source": [
    "drift_report = Report([\n",
    "    DataDriftPreset()\n",
    "])\n",
    "\n",
    "drift_result = drift_report.run(\n",
    "    reference_data=reference_data,\n",
    "    current_data=current_data\n",
    ")\n",
    "\n",
    "drift_result.save_html(\"reports/house_price_drift_report.html\")\n",
    "\n",
    "print(\"Drift report generated successfully!\")"
   ]
  },
